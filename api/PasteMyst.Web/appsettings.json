{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Host": "http://localhost:5000",
  "Https": false,
  "ClientUrl": "http://localhost:3000",
  "RateLimiting": {
    "Enabled": true,
    "General": { "TokenLimit": 100, "TokensPerPeriod": 30, "ReplenishmentPeriodSeconds": 1 },
    "PasteCreate": { "TokenLimit": 5, "TokensPerPeriod": 1, "ReplenishmentPeriodSeconds": 60 },
    "TrustedProxies": [ "172.16.0.0/12" ],
    "ExemptNetworks": [ "192.168.0.0/24" ]
  }
}
